# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-api-key-here
# Use the exact model name your gateway lists (run list_gateway_models.py), e.g. anthropic.claude-sonnet-5-5
CLAUDE_MODEL=anthropic.claude-sonnet-5-5
FHIR_BASE_URL=http://localhost:8080/fhir

# Open WebUI gateway (Anthropic-compatible endpoint). Used by test_gateway.py.
ANTHROPIC_BASE_URL=https://your-gateway.example.com
